{
  "name": "@agentgenome/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/schema.d.ts','dist/schema.d.ts');fs.copyFileSync('../../LICENSE','dist/LICENSE')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0"
}
