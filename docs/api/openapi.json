  "components": {
    "schemas": {
      "Context": {
        "properties": {
          "maxInputTokens": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 256.0,
            "title": "Maxinputtokens",
            "default": 48000
          },
          "reservedOutputTokens": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Reservedoutputtokens",
            "default": 4096
          },
          "compactionThreshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Compactionthreshold",
            "default": 0.75
          },
          "progressiveDisclosure": {
            "type": "boolean",
            "title": "Progressivedisclosure",
            "default": true
          },
          "preserve": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preserve"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Context"
      },
      "Evaluation": {
        "properties": {
          "suite": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Suite"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "suite"
        ],
        "title": "Evaluation"
      },
      "Evolution": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "mutablePaths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mutablepaths"
          },
          "approvalRequired": {
            "type": "boolean",
            "const": true,
            "title": "Approvalrequired",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Evolution"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Harness": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "plan-execute-verify",
              "tool-loop",
              "dag"
            ],
            "title": "Strategy",
            "default": "plan-execute-verify"
          },
          "maxIterations": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Maxiterations",
            "default": 30
          },
          "checkpointEachStep": {
            "type": "boolean",
            "const": true,
            "title": "Checkpointeachstep",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Harness"
      },
      "KeyInput": {
        "properties": {
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "expires_in_hours": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Expires In Hours",
            "default": 24
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scopes"
        ],
        "title": "KeyInput"
      },
      "Limits": {
        "properties": {
          "maxWallSeconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Maxwallseconds",
            "default": 900
          },
          "maxCostUsd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Maxcostusd"
          },
          "maxTotalTokens": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 1.0,
            "title": "Maxtotaltokens",
            "default": 150000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "maxCostUsd"
        ],
        "title": "Limits"
      },
      "Manifest": {
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "agentgenome.io/v1",
            "title": "Apiversion"
          },
          "kind": {
            "type": "string",
            "const": "AgentGenome",
            "title": "Kind"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "spec": {
            "$ref": "#/components/schemas/Spec"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "title": "Manifest"
      },
      "Memory": {
        "properties": {
          "namespaces": {
            "items": {
              "type": "string",
              "enum": [
                "semantic",
                "episodic",
                "procedural"
              ]
            },
            "type": "array",
            "title": "Namespaces"
          },
          "topK": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Topk",
            "default": 5
          },
          "writePolicy": {
            "type": "string",
            "const": "verified-only",
            "title": "Writepolicy",
            "default": "verified-only"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Memory"
      },
      "Metadata": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
