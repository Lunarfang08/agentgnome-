        "title": "Spec"
      },
      "Tools": {
        "properties": {
          "allowed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Allowed"
          },
          "programmaticCalling": {
            "type": "boolean",
            "title": "Programmaticcalling",
            "default": false
          },
          "maxCalls": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Maxcalls",
            "default": 100
          },
          "maxConcurrency": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Maxconcurrency",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
