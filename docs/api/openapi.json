          },
          "parents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Parents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "Metadata"
      },
      "Model": {
        "properties": {
          "route": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Route"
          },
          "fallbackRoutes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Fallbackroutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "route"
        ],
        "title": "Model"
      },
      "NameInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NameInput"
      },
      "RunInput": {
        "properties": {
          "genome_id": {
            "type": "string",
            "title": "Genome Id"
          },
          "task": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Task"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "genome_id",
          "task"
        ],
        "title": "RunInput"
      },
      "Sandbox": {
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "trusted-fixture",
              "restricted-gvisor",
              "firecracker"
            ],
            "title": "Profile"
          },
          "cpu": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Cpu",
            "default": 2
          },
          "memoryMiB": {
            "type": "integer",
            "maximum": 65536.0,
            "minimum": 64.0,
            "title": "Memorymib",
            "default": 1024
          },
          "networkPolicy": {
            "type": "string",
            "const": "deny-by-default",
            "title": "Networkpolicy",
            "default": "deny-by-default"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "Sandbox"
      },
      "Spec": {
        "properties": {
          "model": {
            "$ref": "#/components/schemas/Model"
          },
          "harness": {
            "$ref": "#/components/schemas/Harness"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
