AG_PROFILE=dev
AG_DATABASE_URL=postgresql+asyncpg://agentgenome:local-development@127.0.0.1:55432/agentgenome
AG_TEMPORAL_ADDRESS=127.0.0.1:7233
AG_REDIS_URL=redis://127.0.0.1:56379/0
AG_S3_ENDPOINT=http://127.0.0.1:9000
AG_S3_ACCESS_KEY=local-development
AG_S3_SECRET_KEY=local-development-secret
AG_S3_BUCKET=agentgenome
AG_OIDC_ISSUER=http://127.0.0.1:8081/realms/agentgenome
AG_OIDC_AUDIENCE=agentgenome
AG_OIDC_JWKS_URL=http://127.0.0.1:8081/realms/agentgenome/protocol/openid-connect/certs
AG_DEV_AUTH=true
AG_FAKE_PROVIDER=true
# Generated by make bootstrap; never commit your .env.
# Development login only; production rejects this identity mechanism.
AG_DEV_TOKEN=
# Real providers: configure model IDs and credential environment references explicitly.
AG_MODEL_ID=
AG_PROVIDER_API_KEY=
